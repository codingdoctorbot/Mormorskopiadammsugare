<Application x:Class="PhotoSorter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhotoSorter.App"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TabHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,2" />
        </Style>

        <!-- One number in the run statistics: big value over a small label -->
        <Style x:Key="StatTileBorder" TargetType="Border">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,4,16,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>
    </Application.Resources>
</Application>
