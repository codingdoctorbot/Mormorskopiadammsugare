<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable build: one self-contained Mormorskopiadammsugare.exe that runs without installing .NET.
  dotnet publish src\PhotoSorter.App -p:PublishProfile=Portable   (or scripts\publish.ps1)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- also keep referenced projects' .pdb files (PhotoSorter.Core.pdb) out of the portable folder -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\Mormorskopiadammsugare\</PublishDir>
  </PropertyGroup>
</Project>
