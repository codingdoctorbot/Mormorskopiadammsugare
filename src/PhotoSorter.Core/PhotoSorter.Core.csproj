<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoSorter.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Country polygons for the offline continent lookup – regenerate with tools/GeoPrep.
         Not "countries.bin.gz": MSBuild would read "bin" as a culture (Bini language) and move it to a satellite assembly. -->
    <EmbeddedResource Include="Geo\countries.gz" LogicalName="PhotoSorter.Core.Geo.countries.gz" />
  </ItemGroup>

</Project>
